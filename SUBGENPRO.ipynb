    "#@title Step 1: Download Video from Cloud Link (Auto-Filename)\n",
    "import requests\n",
    "from pathlib import Path\n",
    "\n",
    "target_folder = Path(\"/content/downloads\")\n",
    "target_folder.mkdir(parents=True, exist_ok=True)\n",
    "\n",
    "url = \"http://violetstreamio.com/MRVIOLETSTREAMBOT-AgAD7R15412\"\n",
    "print(\"Connecting to server and downloading video...\")\n",
    "\n",
    "response = requests.get(url, stream=True)\n",
    "response.raise_for_status()\n",
    "\n",
    "# Extract exact filename from server headers if available\n",
    "filename = None\n",
    "content_disp = response.headers.get(\"content-disposition\")\n",
    "if content_disp and \"filename=\" in content_disp:\n",
    "    filename = content_disp.split(\"filename=\")[1].strip('\"\\'')\n",
    "\n",
    "if not filename:\n",
    "    filename = \"downloaded_video.mp4\"\n",
    "\n",
    "video_path = target_folder / filename\n",
    "print(f\"Target path: {video_path}\")\n",
    "\n",
    "with open(video_path, \"wb\") as f:\n",
    "    for chunk in response.iter_content(chunk_size=8192):\n",
    "        if chunk:\n",
    "            f.write(chunk)\n",
    "\n",
    "print(f\"Successfully downloaded: {filename}\")\n"
   ]
  },
