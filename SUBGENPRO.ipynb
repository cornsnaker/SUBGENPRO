    "}\n",
    "transformers_model_map = {\n",
    "    \"kotoba-bilingual-v1.0\": \"kotoba-tech/kotoba-whisper-bilingual-v1.0\",\n",
    "    \"kotoba-v2.0\": \"kotoba-tech/kotoba-whisper-v2.0\",\n",
