    "#@title Step 3: Run WhisperJAV (Local Video)\n",
    "import subprocess\n",
    "import json\n",
    "from pathlib import Path\n",
    "from IPython.display import display, HTML\n",
    "if not 'WHISPERJAV_CONFIG_OK' in locals() or not WHISPERJAV_CONFIG_OK:\n",
    "    raise RuntimeError(\"Configuration has errors or wasn't run. Please run Step 2 first.\")\n",
    "config_path = Path(\"/content/whisperjav_config.json\")\n",
    "with open(config_path, \"w\") as f:\n",
    "    json.dump(WHISPERJAV_CONFIG, f, indent=2)\n",
    "target_folder = Path(\"/content/downloads\")\n",
    "video_files = list(target_folder.glob(\"*.mkv\")) + list(target_folder.glob(\"*.mp4\"))\n",
    "if not video_files:\n",
    "    raise FileNotFoundError(f\"No video files found in {target_folder}!\")\n",
    "input_video = str(video_files[0])\n",
    "print(f\"Found input video: {Path(input_video).name}\")\n",
    "print(\"Starting WhisperJAV processing pipeline...\\n\")\n",
    "cmd = [WHISPERJAV_CMD, input_video, \"--config\", str(config_path), \"--accept-cpu-mode\", \"--device\", \"cpu\"]\n",
    "process = subprocess.Popen(cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT, text=True, bufsize=1)\n",
    "for line in process.stdout:\n",
    "    print(line, end=\"\")\n",
    "process.wait()\n",
    "if process.returncode == 0:\n",
    "    display(HTML('<div style=\"padding:10px;background:#ecfdf5;border-radius:4px;color:#065f46;font-size:12px\"><b>Success!</b> Subtitles generated locally.</div>'))\n",
    "else:\n",
    "    display(HTML(f'<div style=\"padding:10px;background:#fef2f2;border-radius:4px;color:#991b1b;font-size:12px\"><b>Process exited with code {process.returncode}.</b></div>'))\n"
   ]
  }
